<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone for hold-to-talk ASR (AVAudioRecorder). Required under
	     Hardened Runtime. Screen recording, Accessibility (CGEvent paste and
	     AX tree reads) are TCC-gated at runtime and need no entitlement here. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
